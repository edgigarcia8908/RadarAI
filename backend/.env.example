# Copia este archivo a .env y ajusta si hace falta (nunca subas .env a git).
# Mismo cluster Atlas (demo_ceo @ democeoclick) que ya usa todo el ecosistema,
# con su propia base al final del path — ver C:\apps\ceo-ecosistema\backend\.env
# para las credenciales reales (no se ponen acá, este archivo sí va a git).
MONGO_URI=mongodb+srv://usuario:password@democeoclick.j6hzzut.mongodb.net/radarai?appName=democeoclick
PORT=4500

# Login centralizado — ya desplegado, usar directo en producción.
# Local: si corrés ceo-auth-service en tu máquina, apuntá a http://localhost:4100/api
CEO_AUTH_SERVICE_URL=https://auth.ceoclick.pro/api

# Storage centralizado — ya desplegado (documentos que suban ciudadanos/veedurías).
CEO_STORAGE_SERVICE_URL=https://storage.ceoclick.pro/api
STORAGE_SERVICE_KEY=

# Intelligence (RAG + AI + embeddings) — TODAVÍA NO ESTÁ DESPLEGADO.
# Correlo en local (C:\apps\ceo-intelligence-service, npm run dev) mientras tanto,
# o cambiá esta URL cuando se despliegue a intelligence.ceoclick.pro.
CEO_INTELLIGENCE_SERVICE_URL=http://localhost:4400/api
INTELLIGENCE_SERVICE_KEY=

# Socrata (datos.gov.co) — opcional pero recomendado para no chocar el rate limit anónimo.
# Se saca gratis en https://dev.socrata.com/register
SOCRATA_APP_TOKEN=
